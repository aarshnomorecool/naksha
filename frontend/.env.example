# Copy this file to .env and fill in your own Supabase project's values
# (Project Settings -> API in the Supabase dashboard). .env is git-ignored —
# never commit real values here.
#
# Leave .env absent/unfilled to run the map in simulation mode (default,
# zero configuration needed).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
